{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kairos-production-774a.up.railway.app/",
        "EXPO_PUBLIC_RECALL_OPEN_ACCESS": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kairos-production-774a.up.railway.app/",
        "EXPO_PUBLIC_RECALL_OPEN_ACCESS": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
